# ---------------------------------------------------------------------------
# Supabase project configuration
# Copy this file to `.env.local` and fill in the values from:
# Supabase dashboard > Project Settings > API
# `.env.local` is git-ignored and must never be committed.
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Demo mode (temporary)
# "true" replaces sign-in with a local demo session and serves small fixed
# datasets instead of the database. Used only for the public UI demo where
# there is no Supabase project. Leave "false" for real deployments.
# ---------------------------------------------------------------------------
VITE_DEMO_MODE=false

# ---------------------------------------------------------------------------
# Server side only - NEVER prefix these with VITE_ and never commit real values.
# The service role key bypasses every row level security policy. It belongs in
# Edge Function secrets and in your shell when running the seed scripts.
# ---------------------------------------------------------------------------
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
