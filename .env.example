# ---------------------------------------------------------------------------
# Firebase Web App configuration
# Copy this file to `.env.local` and fill in the values from:
# Firebase Console > Project settings > General > Your apps > Web app > SDK setup
# `.env.local` is git-ignored and must never be committed.
# ---------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional - only needed if Google Analytics is enabled for the Firebase project
VITE_FIREBASE_MEASUREMENT_ID=

# ---------------------------------------------------------------------------
# Local development
# Set to "true" to route Auth / Firestore / Storage to the Firebase Emulator
# Suite instead of the live project. Run `npm run emulators` in a second shell.
# ---------------------------------------------------------------------------
VITE_USE_FIREBASE_EMULATORS=false
