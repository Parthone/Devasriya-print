# ---------------------------------------------------------------------------
# Credentials for `npm run test:integration` only.
#
# Copy to `.env.integration`, which is git-ignored. These are NOT browser
# values: nothing here is prefixed VITE_, so Vite cannot inline any of it into
# a bundle.
#
# SUPABASE_SERVICE_ROLE_KEY bypasses every row level security policy in the
# database. Treat it like a database superuser password: never commit it, never
# paste it into a chat, never put it in a GitHub Actions step for the frontend.
#
# Local stack:  run `supabase status` and copy the values it prints.
# Live project: Supabase dashboard > Project Settings > API.
# ---------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Only needed for applying migrations with the CLI:
#   npx supabase db push --db-url "$SUPABASE_DB_URL"
SUPABASE_DB_URL=
