# Keep line endings consistent on every machine.
#
# The repo standard is LF (see .editorconfig and .prettierrc.json). Without
# this, a Windows checkout rewrites files with CRLF and `prettier --check`
# fails even though nothing really changed.
* text=auto eol=lf

# Binary files must never be touched.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
