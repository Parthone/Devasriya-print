rules_version = '2';

// ---------------------------------------------------------------------------
// Devasriya Print - Firestore security rules
//
// Baseline is deny-all. A collection is opened up only by the module that owns
// it, together with the role model it depends on.
//
// Open collections:
//   users      (Module 1 - Authentication & Users)
//   auditLogs  (Module 2 - Roles & Permissions)
//   customers  (Module 3 - Customer Management)
//   enquiries, jobs, locations, counters  (Module 4 - Enquiries & Jobs)
//   products, jobPricing  (Module 5 - Measurements & Pricing)
//
// Authorisation mirrors the application permission matrix in
// src/features/permissions/matrix.ts. Hidden UI is never the control: every
// permission checked in the browser is checked again here.
// ---------------------------------------------------------------------------
service cloud.firestore {
  match /databases/{database}/documents {

    function userPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function hasProfile() {
      return isSignedIn() && exists(userPath(request.auth.uid));
    }

    function myProfile() {
      return get(userPath(request.auth.uid)).data;
    }

    // Authentication alone grants nothing: a profile must exist and be active.
    function isActiveUser() {
      return hasProfile() && myProfile().isActive == true;
    }

    // The permission matrix, limited to the permissions these rules enforce.
    // Every module extends this map when it opens up its own collections.
    function rolePermissions() {
      return {
        'owner': ['employees:view', 'employees:manage', 'employees:manage-admins',
                  'settings:view', 'settings:manage',
                  'customers:view', 'customers:create', 'customers:edit',
                  'enquiries:view', 'enquiries:create', 'enquiries:edit',
                  'jobs:view', 'jobs:create', 'jobs:edit', 'jobs:assign',
                  'estimates:view', 'estimates:create', 'estimates:edit'],
        'admin': ['employees:view', 'employees:manage', 'settings:view',
                  'customers:view', 'customers:create', 'customers:edit',
                  'enquiries:view', 'enquiries:create', 'enquiries:edit',
                  'jobs:view', 'jobs:create', 'jobs:edit', 'jobs:assign',
                  'estimates:view', 'estimates:create', 'estimates:edit'],
        'sales': ['customers:view', 'customers:create', 'customers:edit',
                  'enquiries:view', 'enquiries:create', 'enquiries:edit',
                  'jobs:view', 'jobs:create', 'jobs:edit',
                  'estimates:view', 'estimates:create', 'estimates:edit'],
        'designer': ['customers:view', 'enquiries:view', 'jobs:view'],
        'production': ['employees:view', 'customers:view',
                       'enquiries:view', 'jobs:view', 'jobs:edit'],
        'accounts': ['customers:view', 'jobs:view', 'estimates:view'],
        'viewer': ['customers:view', 'enquiries:view', 'jobs:view', 'estimates:view']
      };
    }

    function can(permission) {
      return isActiveUser() && permission in rolePermissions()[myProfile().role];
    }

    function isPrivilegedRole(role) {
      return role in ['owner', 'admin'];
    }

    function isValidProfile(data) {
      return data.keys().hasOnly([
               'name', 'email', 'mobile', 'designation', 'department', 'role',
               'isActive', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy'
             ])
             && data.keys().hasAll([
               'name', 'email', 'mobile', 'designation', 'department', 'role',
               'isActive', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy'
             ])
             && data.name is string && data.name.size() >= 2 && data.name.size() <= 120
             && data.email is string && data.email.size() >= 5 && data.email.size() <= 200
             && data.mobile is string && data.mobile.matches('^[6-9][0-9]{9}$')
             && data.designation is string
             && data.department is string
             && data.role in ['owner', 'admin', 'sales', 'designer', 'production', 'accounts', 'viewer']
             && data.isActive is bool
             && data.createdBy is string
             && data.updatedBy is string;
    }

    // Pricing lives in its own collection so that reading it can be gated on
    // estimates:view - Firestore has no field level read rules, so money kept
    // on the job document would be readable by anyone who may read jobs.
    //
    // Rules cannot walk every line of an array, so they check the shape and the
    // totals that matter: money is whole paise in rupees, the total is never
    // negative, an adjustment always carries a reason, and the number of lines
    // is capped. Line by line validation is done by the zod schema at the
    // data-access boundary.
    function isValidMoney(value) {
      return value is map
             && value.keys().hasOnly(['paise', 'currency'])
             && value.paise is int
             && value.currency == 'INR';
    }

    function isValidPricing(pricing) {
      return pricing.keys().hasAll(['jobId', 'lines', 'subtotal', 'total',
                                    'createdAt', 'createdBy', 'updatedAt', 'updatedBy'])
             && pricing.keys().hasOnly(['jobId', 'lines', 'subtotal', 'adjustment', 'total',
                                        'createdAt', 'createdBy', 'updatedAt', 'updatedBy'])
             && pricing.lines is list
             && pricing.lines.size() <= 50
             && isValidMoney(pricing.subtotal)
             && isValidMoney(pricing.total)
             && pricing.total.paise >= 0
             && pricing.updatedBy is string
             && (pricing.get('adjustment', null) == null
                 || (pricing.adjustment.keys().hasOnly(['amount', 'reason'])
                     && isValidMoney(pricing.adjustment.amount)
                     && pricing.adjustment.reason is string
                     && pricing.adjustment.reason.size() > 0));
    }

    match /users/{userId} {
      // A signed-in user may always read their own profile - the application
      // needs it to tell "deactivated" apart from "no profile at all".
      allow get: if isSignedIn() && (request.auth.uid == userId || can('employees:view'));
      allow list: if can('employees:view');

      allow create: if can('employees:manage')
                    && isValidProfile(request.resource.data)
                    && request.resource.data.createdBy == request.auth.uid
                    && request.resource.data.updatedBy == request.auth.uid
                    // Handing out owner or admin is reserved for the owner.
                    && (!isPrivilegedRole(request.resource.data.role)
                        || can('employees:manage-admins'));

      // `resource` is null when Firestore evaluates the update branch for a
      // write to a document that does not exist yet; guard so the rule returns
      // false instead of raising an evaluation error.
      allow update: if can('employees:manage')
                    && resource != null
                    && isValidProfile(request.resource.data)
                    && request.resource.data.email == resource.data.email
                    && request.resource.data.createdAt == resource.data.createdAt
                    && request.resource.data.createdBy == resource.data.createdBy
                    && request.resource.data.updatedBy == request.auth.uid
                    // Only the owner may edit an owner or admin record, or
                    // promote somebody into one of those roles.
                    && (!isPrivilegedRole(resource.data.role)
                        || can('employees:manage-admins'))
                    && (!isPrivilegedRole(request.resource.data.role)
                        || can('employees:manage-admins'))
                    // Administrators cannot demote or deactivate themselves and
                    // lock the business out of its own software.
                    && (request.auth.uid != userId
                        || (request.resource.data.role == resource.data.role
                            && request.resource.data.isActive == resource.data.isActive));

      // Staff records are never deleted: history and audit trails depend on them.
      allow delete: if false;
    }

    // Append-only trail of role and status changes. Written by the browser in
    // the same batch as the change it describes; never edited or removed.
    match /auditLogs/{entryId} {
      function isValidAuditEntry(data) {
        return data.keys().hasOnly([
                 'action', 'targetUserId', 'targetName', 'actorId', 'actorName',
                 'before', 'after', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy'
               ])
               && data.keys().hasAll([
                 'action', 'targetUserId', 'targetName', 'actorId', 'actorName',
                 'before', 'after', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy'
               ])
               && data.action in ['employee-created', 'role-changed', 'status-changed',
                                  'profile-updated']
               && data.targetUserId is string && data.targetUserId.size() > 0
               && data.targetName is string
               && data.before is string && data.after is string
               // The trail records who actually made the change.
               && data.actorId == request.auth.uid
               && data.createdBy == request.auth.uid
               && data.updatedBy == request.auth.uid
               // Server time only, so entries cannot be back-dated.
               && data.createdAt == request.time
               && data.updatedAt == request.time;
      }

      allow get, list: if can('employees:manage');
      allow create: if can('employees:manage') && isValidAuditEntry(request.resource.data);
      allow update, delete: if false;
    }

    // Customers are archived, never deleted: enquiries, jobs, estimates and
    // invoices all point at these records.
    match /customers/{customerId} {
      function requiredCustomerFields() {
        return ['name', 'nameLower', 'type', 'mobile', 'address', 'city', 'state',
                'pincode', 'preferredLanguage', 'isArchived', 'portalUserId',
                'createdAt', 'createdBy', 'updatedAt', 'updatedBy'];
      }

      function allowedCustomerFields() {
        return requiredCustomerFields().concat(
          ['businessName', 'alternateMobile', 'email', 'gstin', 'notes']
        );
      }

      function isValidCustomer(data) {
        return data.keys().hasAll(requiredCustomerFields())
               && data.keys().hasOnly(allowedCustomerFields())
               && data.name is string && data.name.size() >= 2 && data.name.size() <= 120
               && data.nameLower == data.name.lower()
               && data.type in ['individual', 'business']
               && data.mobile is string && data.mobile.matches('^[6-9][0-9]{9}$')
               && data.address is string && data.address.size() >= 3 && data.address.size() <= 400
               && data.city is string && data.city.size() >= 2 && data.city.size() <= 80
               && data.state is string && data.state.size() > 1
               && data.pincode is string && data.pincode.matches('^[1-9][0-9]{5}$')
               && data.preferredLanguage in ['hi', 'en']
               && data.isArchived is bool
               && (data.portalUserId == null || data.portalUserId is string)
               && data.updatedBy is string;
      }

      allow get, list: if can('customers:view');

      allow create: if can('customers:create')
                    && isValidCustomer(request.resource.data)
                    && request.resource.data.createdBy == request.auth.uid
                    && request.resource.data.updatedBy == request.auth.uid
                    // The customer portal link is set by the portal module only.
                    && request.resource.data.portalUserId == null;

      allow update: if can('customers:edit')
                    && resource != null
                    && isValidCustomer(request.resource.data)
                    && request.resource.data.createdAt == resource.data.createdAt
                    && request.resource.data.createdBy == resource.data.createdBy
                    && request.resource.data.updatedBy == request.auth.uid
                    // An ordinary edit can never touch the portal account link.
                    && request.resource.data.portalUserId == resource.data.portalUserId;

      // No role may delete a customer, from any client.
      allow delete: if false;
    }

    // ---- Module 4: enquiries, jobs, pickup offices and number counters ----

    function isPresentString(value) {
      return value is string && value.size() > 0;
    }

    function nullableString(value) {
      return value == null || value is string;
    }

    // Document numbers. Never listed, never reset, and only ever nudged up by
    // one as part of creating the record that consumes the number.
    match /counters/{counterId} {
      function mayUseCounter() {
        return (counterId.matches('^enquiries-[0-9]{4}$') && can('enquiries:create'))
               || (counterId.matches('^jobs-[0-9]{4}$') && can('jobs:create'));
      }

      allow get: if mayUseCounter();
      allow list: if false;
      allow create: if mayUseCounter()
                    && request.resource.data.keys().hasOnly(['value'])
                    && request.resource.data.value == 1;
      allow update: if mayUseCounter()
                    && request.resource.data.keys().hasOnly(['value'])
                    && request.resource.data.value is int
                    && request.resource.data.value == resource.data.value + 1;
      allow delete: if false;
    }

    // Pickup offices. Any active staff member may read them, because anyone
    // creating a job has to choose one; only the owner may change them.
    match /locations/{locationId} {
      function isValidLocation(data) {
        return data.keys().hasAll(['name', 'address', 'isActive', 'contactUserId',
                                   'createdAt', 'createdBy', 'updatedAt', 'updatedBy'])
               && data.keys().hasOnly(['name', 'address', 'phone', 'contactUserId',
                                       'contactName', 'contactMobile', 'isActive',
                                       'createdAt', 'createdBy', 'updatedAt', 'updatedBy'])
               && isPresentString(data.name) && data.name.size() <= 120
               && isPresentString(data.address) && data.address.size() <= 400
               && data.isActive is bool
               && nullableString(data.contactUserId)
               && data.updatedBy is string;
      }

      allow get, list: if isActiveUser();
      allow create: if can('settings:manage')
                    && isValidLocation(request.resource.data)
                    && request.resource.data.createdBy == request.auth.uid
                    && request.resource.data.updatedBy == request.auth.uid;
      allow update: if can('settings:manage')
                    && resource != null
                    && isValidLocation(request.resource.data)
                    && request.resource.data.createdAt == resource.data.createdAt
                    && request.resource.data.createdBy == resource.data.createdBy
                    && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if false;
    }

    // Enquiries. Never deleted: they become jobs, or a record of lost work.
    match /enquiries/{enquiryId} {
      function isValidEnquiry(data) {
        return data.keys().hasAll(['enquiryNumber', 'customerId', 'customerName',
                                   'customerMobile', 'enquiryDate', 'source',
                                   'requirementText', 'status', 'followUps',
                                   'createdAt', 'createdBy', 'updatedAt', 'updatedBy'])
               && data.keys().hasOnly(['enquiryNumber', 'customerId', 'customerName',
                                       'customerMobile', 'enquiryDate', 'source',
                                       'requirementText', 'requirementAudio', 'notes',
                                       'assignedToId', 'assignedToName', 'nextFollowUpAt',
                                       'followUps', 'status', 'lostReason',
                                       'convertedJobId', 'convertedAt',
                                       'createdAt', 'createdBy', 'updatedAt', 'updatedBy'])
               && data.enquiryNumber.matches('^ENQ-[0-9]{4}-[0-9]{4}$')
               && isPresentString(data.customerId)
               && data.customerMobile is string
               && data.source in ['walk-in', 'phone', 'whatsapp', 'referral', 'repeat', 'other']
               && data.status in ['new', 'contacted', 'follow-up', 'quotation-required',
                                  'converted', 'lost', 'closed']
               && data.requirementText is string && data.requirementText.size() <= 2000
               && data.followUps is list && data.followUps.size() <= 50
               && data.updatedBy is string;
      }

      allow get, list: if can('enquiries:view');

      allow create: if can('enquiries:create')
                    && isValidEnquiry(request.resource.data)
                    && request.resource.data.createdBy == request.auth.uid
                    && request.resource.data.updatedBy == request.auth.uid
                    && request.resource.data.status != 'converted'
                    && request.resource.data.convertedJobId == null;

      allow update: if can('enquiries:edit')
                    && resource != null
                    && isValidEnquiry(request.resource.data)
                    && request.resource.data.enquiryNumber == resource.data.enquiryNumber
                    && request.resource.data.createdAt == resource.data.createdAt
                    && request.resource.data.createdBy == resource.data.createdBy
                    && request.resource.data.updatedBy == request.auth.uid
                    && (
                         (request.resource.data.convertedJobId == resource.data.convertedJobId
                          && request.resource.data.status != 'converted'
                          && resource.data.convertedJobId == null)
                         || (resource.data.convertedJobId == null
                             && request.resource.data.convertedJobId is string
                             && request.resource.data.status == 'converted'
                             && can('jobs:create'))
                         || (resource.data.convertedJobId != null
                             && request.resource.data.convertedJobId == resource.data.convertedJobId
                             && request.resource.data.status == 'converted')
                       );

      allow delete: if false;
    }

    // Jobs. Never deleted; cancelled instead, so numbers stay meaningful.
    match /jobs/{jobId} {
      function isValidJob(data) {
        return data.keys().hasAll(['jobNumber', 'customerId', 'customerName', 'customerMobile',
                                   'jobDate', 'title', 'requirementText', 'priority', 'status',
                                   'createdAt', 'createdBy', 'updatedAt', 'updatedBy'])
               && data.keys().hasOnly(['jobNumber', 'customerId', 'customerName', 'customerMobile',
                                       'enquiryId', 'enquiryNumber', 'jobDate', 'title',
                                       'requirementText', 'requirementAudio', 'priority',
                                       'expectedDeliveryDate', 'internalNotes',
                                       'pickupLocationId', 'pickupLocationName',
                                       'contactPersonId', 'contactPersonName',
                                       'contactPersonMobile', 'assignedToId', 'assignedToName',
                                       'status', 'createdAt', 'createdBy',
                                       'updatedAt', 'updatedBy'])
               && data.jobNumber.matches('^JOB-[0-9]{4}-[0-9]{4}$')
               && isPresentString(data.customerId)
               && isPresentString(data.title) && data.title.size() <= 160
               && data.requirementText is string && data.requirementText.size() <= 2000
               && data.priority in ['normal', 'urgent']
               && data.status in ['open', 'in-progress', 'ready', 'delivered', 'on-hold',
                                  'cancelled']
               && nullableString(data.enquiryId)
               && nullableString(data.pickupLocationId)
               && nullableString(data.assignedToId)
               && data.updatedBy is string;
      }

      allow get, list: if can('jobs:view');

      allow create: if can('jobs:create')
                    && isValidJob(request.resource.data)
                    && request.resource.data.createdBy == request.auth.uid
                    && request.resource.data.updatedBy == request.auth.uid
                    && request.resource.data.assignedToId == null;

      allow update: if can('jobs:edit')
                    && resource != null
                    && isValidJob(request.resource.data)
                    && request.resource.data.jobNumber == resource.data.jobNumber
                    && request.resource.data.createdAt == resource.data.createdAt
                    && request.resource.data.createdBy == resource.data.createdBy
                    && request.resource.data.enquiryId == resource.data.enquiryId
                    && request.resource.data.updatedBy == request.auth.uid
                    // Changing who is responsible is a separate permission.
                    && (request.resource.data.assignedToId == resource.data.assignedToId
                        || can('jobs:assign'));

      allow delete: if false;
    }

    // The rate card. Anyone active may read it, because anyone pricing a job
    // needs it; only the owner may change it, and nothing is ever deleted.
    match /products/{productId} {
      function isValidProduct(data) {
        return data.keys().hasAll(['name', 'category', 'pricingMethod', 'defaultRate',
                                   'defaultRateUnit', 'isActive',
                                   'createdAt', 'createdBy', 'updatedAt', 'updatedBy'])
               && data.keys().hasOnly(['name', 'category', 'pricingMethod', 'defaultRate',
                                       'defaultRateUnit', 'description', 'isActive',
                                       'createdAt', 'createdBy', 'updatedAt', 'updatedBy'])
               && data.name is string && data.name.size() >= 2 && data.name.size() <= 120
               && data.category in ['printing', 'material', 'finishing', 'service', 'other']
               && data.pricingMethod in ['per-square-foot', 'per-square-meter',
                                         'per-running-foot', 'per-running-meter',
                                         'per-piece', 'flat-rate']
               && data.defaultRateUnit in ['sq-ft', 'sq-m', 'running-ft', 'running-m',
                                           'piece', 'flat']
               && isValidMoney(data.defaultRate)
               && data.defaultRate.paise >= 0
               && data.isActive is bool
               && data.updatedBy is string;
      }

      allow get, list: if isActiveUser();
      allow create: if can('settings:manage')
                    && isValidProduct(request.resource.data)
                    && request.resource.data.createdBy == request.auth.uid
                    && request.resource.data.updatedBy == request.auth.uid;
      allow update: if can('settings:manage')
                    && resource != null
                    && isValidProduct(request.resource.data)
                    && request.resource.data.createdAt == resource.data.createdAt
                    && request.resource.data.createdBy == resource.data.createdBy
                    && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if false;
    }

    // Job pricing. Kept out of the job document so that seeing a job never
    // means seeing what it costs: reading needs estimates:view, which designer
    // and production do not have. Writing needs both jobs:edit and
    // estimates:create, so production - which may move a job along - still
    // cannot change a price.
    match /jobPricing/{jobId} {
      function mayPrice() {
        return can('jobs:edit') && can('estimates:create');
      }

      allow get, list: if can('estimates:view');

      allow create: if mayPrice()
                    && isValidPricing(request.resource.data)
                    && request.resource.data.jobId == jobId
                    && request.resource.data.createdBy == request.auth.uid
                    && request.resource.data.updatedBy == request.auth.uid;

      allow update: if mayPrice()
                    && resource != null
                    && isValidPricing(request.resource.data)
                    && request.resource.data.jobId == resource.data.jobId
                    && request.resource.data.createdAt == resource.data.createdAt
                    && request.resource.data.createdBy == resource.data.createdBy
                    && request.resource.data.updatedBy == request.auth.uid;

      // Pricing history stays with the job it belongs to.
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
