rules_version = '2';

// ---------------------------------------------------------------------------
// Devasriya Print - Firestore security rules
//
// MODULE 0 BASELINE: deny everything.
//
// Real rules are written per module, alongside the collections they protect.
// A collection is only opened up once its module is implemented and its
// role/permission model is defined (see the auth & permissions module).
// Never relax this file to a blanket allow - not even temporarily.
// ---------------------------------------------------------------------------
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
