rules_version = '2';

// ---------------------------------------------------------------------------
// Devasriya Print - Firestore security rules
//
// Baseline is deny-all. A collection is opened up only by the module that owns
// it, together with the role model it depends on.
//
// Open collections:
//   users      (Module 1 - Authentication & Users)
//   auditLogs  (Module 2 - Roles & Permissions)
//   customers  (Module 3 - Customer Management)
//   enquiries, jobs, locations, counters  (Module 4 - Enquiries & Jobs)
//   products, jobPricing  (Module 5 - Measurements & Pricing)
//   estimates  (Module 6 - Estimates & Quotations)
//   designs, customerAccounts  (Module 7 - Design Uploads & Approvals)
//
// Two kinds of principal exist. An employee has users/{uid}; a customer has
// customerAccounts/{uid} and no role, no permission and no reach beyond their
// own jobs and their own designs. One uid is never both: creating either kind
// is refused when the other already exists.
//
// Authorisation mirrors the application permission matrix in
// src/features/permissions/matrix.ts. Hidden UI is never the control: every
// permission checked in the browser is checked again here.
// ---------------------------------------------------------------------------
service cloud.firestore {
  match /databases/{database}/documents {

    function userPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function hasProfile() {
      return isSignedIn() && exists(userPath(request.auth.uid));
    }

    function myProfile() {
      return get(userPath(request.auth.uid)).data;
    }

    // Authentication alone grants nothing: a profile must exist and be active.
    function isActiveUser() {
      return hasProfile() && myProfile().isActive == true;
    }

    // The permission matrix, limited to the permissions these rules enforce.
    // Every module extends this map when it opens up its own collections.
    function rolePermissions() {
      return {
        'owner': ['employees:view', 'employees:manage', 'employees:manage-admins',
                  'settings:view', 'settings:manage',
                  'customers:view', 'customers:create', 'customers:edit',
                  'enquiries:view', 'enquiries:create', 'enquiries:edit',
                  'jobs:view', 'jobs:create', 'jobs:edit', 'jobs:assign',
                  'estimates:view', 'estimates:create', 'estimates:edit',
                  'estimates:approve',
                  'designs:view', 'designs:upload', 'designs:approve'],
        'admin': ['employees:view', 'employees:manage', 'settings:view',
                  'customers:view', 'customers:create', 'customers:edit',
                  'enquiries:view', 'enquiries:create', 'enquiries:edit',
                  'jobs:view', 'jobs:create', 'jobs:edit', 'jobs:assign',
                  'estimates:view', 'estimates:create', 'estimates:edit',
                  'estimates:approve',
                  'designs:view', 'designs:upload', 'designs:approve'],
        'sales': ['customers:view', 'customers:create', 'customers:edit',
                  'enquiries:view', 'enquiries:create', 'enquiries:edit',
                  'jobs:view', 'jobs:create', 'jobs:edit',
                  'estimates:view', 'estimates:create', 'estimates:edit',
                  'estimates:approve',
                  'designs:view', 'designs:approve'],
        'designer': ['customers:view', 'enquiries:view', 'jobs:view',
                     'designs:view', 'designs:upload'],
        'production': ['employees:view', 'customers:view',
                       'enquiries:view', 'jobs:view', 'jobs:edit',
                       'designs:view'],
        'accounts': ['customers:view', 'jobs:view', 'estimates:view'],
        'viewer': ['customers:view', 'enquiries:view', 'jobs:view', 'estimates:view',
                   'designs:view']
      };
    }

    function can(permission) {
      return isActiveUser() && permission in rolePermissions()[myProfile().role];
    }

    function customerAccountPath(uid) {
      return /databases/$(database)/documents/customerAccounts/$(uid);
    }

    /**
     * The other kind of principal: a customer with a review-portal login.
     *
     * A customer holds no role and appears nowhere in rolePermissions(), so
     * `can(...)` is false for them everywhere. Every door they are allowed
     * through is opened explicitly, by their own customer id, below.
     */
    function isCustomer() {
      return isSignedIn()
             && exists(customerAccountPath(request.auth.uid))
             && get(customerAccountPath(request.auth.uid)).data.isActive == true;
    }

    function myCustomerId() {
      return get(customerAccountPath(request.auth.uid)).data.customerId;
    }

    function isMyCustomerRecord(customerId) {
      return isCustomer() && customerId == myCustomerId();
    }

    function isPrivilegedRole(role) {
      return role in ['owner', 'admin'];
    }

    function isValidProfile(data) {
      return data.keys().hasOnly([
               'name', 'email', 'mobile', 'designation', 'department', 'role',
               'isActive', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy'
             ])
             && data.keys().hasAll([
               'name', 'email', 'mobile', 'designation', 'department', 'role',
               'isActive', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy'
             ])
             && data.name is string && data.name.size() >= 2 && data.name.size() <= 120
             && data.email is string && data.email.size() >= 5 && data.email.size() <= 200
             && data.mobile is string && data.mobile.matches('^[6-9][0-9]{9}$')
             && data.designation is string
             && data.department is string
             && data.role in ['owner', 'admin', 'sales', 'designer', 'production', 'accounts', 'viewer']
             && data.isActive is bool
             && data.createdBy is string
             && data.updatedBy is string;
    }

    // Pricing lives in its own collection so that reading it can be gated on
    // estimates:view - Firestore has no field level read rules, so money kept
    // on the job document would be readable by anyone who may read jobs.
    //
    // Rules cannot walk every line of an array, so they check the shape and the
    // totals that matter: money is whole paise in rupees, the total is never
    // negative, an adjustment always carries a reason, and the number of lines
    // is capped. Line by line validation is done by the zod schema at the
    // data-access boundary.
    function isValidMoney(value) {
      return value is map
             && value.keys().hasOnly(['paise', 'currency'])
             && value.paise is int
             && value.currency == 'INR';
    }

    function isValidPricing(pricing) {
      return pricing.keys().hasAll(['jobId', 'lines', 'subtotal', 'total',
                                    'createdAt', 'createdBy', 'updatedAt', 'updatedBy'])
             && pricing.keys().hasOnly(['jobId', 'lines', 'subtotal', 'adjustment', 'total',
                                        'createdAt', 'createdBy', 'updatedAt', 'updatedBy'])
             && pricing.lines is list
             && pricing.lines.size() <= 50
             && isValidMoney(pricing.subtotal)
             && isValidMoney(pricing.total)
             && pricing.total.paise >= 0
             && pricing.updatedBy is string
             && (pricing.get('adjustment', null) == null
                 || (pricing.adjustment.keys().hasOnly(['amount', 'reason'])
                     && isValidMoney(pricing.adjustment.amount)
                     && pricing.adjustment.reason is string
                     && pricing.adjustment.reason.size() > 0));
    }

    match /users/{userId} {
      // A signed-in user may always read their own profile - the application
      // needs it to tell "deactivated" apart from "no profile at all".
      allow get: if isSignedIn() && (request.auth.uid == userId || can('employees:view'));
      allow list: if can('employees:view');

      allow create: if can('employees:manage')
                    && isValidProfile(request.resource.data)
                    && request.resource.data.createdBy == request.auth.uid
                    && request.resource.data.updatedBy == request.auth.uid
                    // Handing out owner or admin is reserved for the owner.
                    && (!isPrivilegedRole(request.resource.data.role)
                        || can('employees:manage-admins'))
                    // A uid is one kind of principal or the other, never both:
                    // a customer login can never be turned into staff access.
                    && !exists(customerAccountPath(userId));

      // `resource` is null when Firestore evaluates the update branch for a
      // write to a document that does not exist yet; guard so the rule returns
      // false instead of raising an evaluation error.
      allow update: if can('employees:manage')
                    && resource != null
                    && isValidProfile(request.resource.data)
                    && request.resource.data.email == resource.data.email
                    && request.resource.data.createdAt == resource.data.createdAt
                    && request.resource.data.createdBy == resource.data.createdBy
                    && request.resource.data.updatedBy == request.auth.uid
                    // Only the owner may edit an owner or admin record, or
                    // promote somebody into one of those roles.
                    && (!isPrivilegedRole(resource.data.role)
                        || can('employees:manage-admins'))
                    && (!isPrivilegedRole(request.resource.data.role)
                        || can('employees:manage-admins'))
                    // Administrators cannot demote or deactivate themselves and
                    // lock the business out of its own software.
                    && (request.auth.uid != userId
                        || (request.resource.data.role == resource.data.role
                            && request.resource.data.isActive == resource.data.isActive));

      // Staff records are never deleted: history and audit trails depend on them.
      allow delete: if false;
    }

    // Append-only trail of role and status changes. Written by the browser in
    // the same batch as the change it describes; never edited or removed.
    match /auditLogs/{entryId} {
      function isValidAuditEntry(data) {
        return data.keys().hasOnly([
                 'action', 'targetUserId', 'targetName', 'actorId', 'actorName',
                 'before', 'after', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy'
               ])
               && data.keys().hasAll([
                 'action', 'targetUserId', 'targetName', 'actorId', 'actorName',
                 'before', 'after', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy'
               ])
               && data.action in ['employee-created', 'role-changed', 'status-changed',
                                  'profile-updated']
               && data.targetUserId is string && data.targetUserId.size() > 0
               && data.targetName is string
               && data.before is string && data.after is string
               // The trail records who actually made the change.
               && data.actorId == request.auth.uid
               && data.createdBy == request.auth.uid
               && data.updatedBy == request.auth.uid
               // Server time only, so entries cannot be back-dated.
               && data.createdAt == request.time
               && data.updatedAt == request.time;
      }

      allow get, list: if can('employees:manage');
      allow create: if can('employees:manage') && isValidAuditEntry(request.resource.data);
      allow update, delete: if false;
    }

    // Customers are archived, never deleted: enquiries, jobs, estimates and
    // invoices all point at these records.
    match /customers/{customerId} {
      function requiredCustomerFields() {
        return ['name', 'nameLower', 'type', 'mobile', 'address', 'city', 'state',
                'pincode', 'preferredLanguage', 'isArchived', 'portalUserId',
                'createdAt', 'createdBy', 'updatedAt', 'updatedBy'];
      }

      function allowedCustomerFields() {
        return requiredCustomerFields().concat(
          ['businessName', 'alternateMobile', 'email', 'gstin', 'notes']
        );
      }

      function isValidCustomer(data) {
        return data.keys().hasAll(requiredCustomerFields())
               && data.keys().hasOnly(allowedCustomerFields())
               && data.name is string && data.name.size() >= 2 && data.name.size() <= 120
               && data.nameLower == data.name.lower()
               && data.type in ['individual', 'business']
               && data.mobile is string && data.mobile.matches('^[6-9][0-9]{9}$')
               && data.address is string && data.address.size() >= 3 && data.address.size() <= 400
               && data.city is string && data.city.size() >= 2 && data.city.size() <= 80
               && data.state is string && data.state.size() > 1
               && data.pincode is string && data.pincode.matches('^[1-9][0-9]{5}$')
               && data.preferredLanguage in ['hi', 'en']
               && data.isArchived is bool
               && (data.portalUserId == null || data.portalUserId is string)
               && data.updatedBy is string;
      }

      allow get, list: if can('customers:view');

      allow create: if can('customers:create')
                    && isValidCustomer(request.resource.data)
                    && request.resource.data.createdBy == request.auth.uid
                    && request.resource.data.updatedBy == request.auth.uid
                    // The customer portal link is set by the portal module only.
                    && request.resource.data.portalUserId == null;

      allow update: if can('customers:edit')
                    && resource != null
                    && isValidCustomer(request.resource.data)
                    && request.resource.data.createdAt == resource.data.createdAt
                    && request.resource.data.createdBy == resource.data.createdBy
                    && request.resource.data.updatedBy == request.auth.uid
                    // An ordinary edit can never touch the portal account link.
                    && request.resource.data.portalUserId == resource.data.portalUserId;

      // No role may delete a customer, from any client.
      allow delete: if false;
    }

    // ---- Module 4: enquiries, jobs, pickup offices and number counters ----

    function isPresentString(value) {
      return value is string && value.size() > 0;
    }

    function nullableString(value) {
      return value == null || value is string;
    }

    // Document numbers. Never listed, never reset, and only ever nudged up by
    // one as part of creating the record that consumes the number.
    match /counters/{counterId} {
      function mayUseCounter() {
        return (counterId.matches('^enquiries-[0-9]{4}$') && can('enquiries:create'))
               || (counterId.matches('^jobs-[0-9]{4}$') && can('jobs:create'))
               || (counterId.matches('^estimates-[0-9]{4}$') && can('estimates:create'));
      }

      allow get: if mayUseCounter();
      allow list: if false;
      allow create: if mayUseCounter()
                    && request.resource.data.keys().hasOnly(['value'])
                    && request.resource.data.value == 1;
      allow update: if mayUseCounter()
                    && request.resource.data.keys().hasOnly(['value'])
                    && request.resource.data.value is int
                    && request.resource.data.value == resource.data.value + 1;
      allow delete: if false;
    }

    // Pickup offices. Any active staff member may read them, because anyone
    // creating a job has to choose one; only the owner may change them.
    match /locations/{locationId} {
      function isValidLocation(data) {
        return data.keys().hasAll(['name', 'address', 'isActive', 'contactUserId',
                                   'createdAt', 'createdBy', 'updatedAt', 'updatedBy'])
               && data.keys().hasOnly(['name', 'address', 'phone', 'contactUserId',
                                       'contactName', 'contactMobile', 'isActive',
                                       'createdAt', 'createdBy', 'updatedAt', 'updatedBy'])
               && isPresentString(data.name) && data.name.size() <= 120
               && isPresentString(data.address) && data.address.size() <= 400
               && data.isActive is bool
               && nullableString(data.contactUserId)
               && data.updatedBy is string;
      }

      allow get, list: if isActiveUser();
      allow create: if can('settings:manage')
                    && isValidLocation(request.resource.data)
                    && request.resource.data.createdBy == request.auth.uid
                    && request.resource.data.updatedBy == request.auth.uid;
      allow update: if can('settings:manage')
                    && resource != null
                    && isValidLocation(request.resource.data)
                    && request.resource.data.createdAt == resource.data.createdAt
                    && request.resource.data.createdBy == resource.data.createdBy
                    && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if false;
    }

    // Enquiries. Never deleted: they become jobs, or a record of lost work.
    match /enquiries/{enquiryId} {
      function isValidEnquiry(data) {
        return data.keys().hasAll(['enquiryNumber', 'customerId', 'customerName',
                                   'customerMobile', 'enquiryDate', 'source',
                                   'requirementText', 'status', 'followUps',
                                   'createdAt', 'createdBy', 'updatedAt', 'updatedBy'])
               && data.keys().hasOnly(['enquiryNumber', 'customerId', 'customerName',
                                       'customerMobile', 'enquiryDate', 'source',
                                       'requirementText', 'requirementAudio', 'notes',
                                       'assignedToId', 'assignedToName', 'nextFollowUpAt',
                                       'followUps', 'status', 'lostReason',
                                       'convertedJobId', 'convertedAt',
                                       'createdAt', 'createdBy', 'updatedAt', 'updatedBy'])
               && data.enquiryNumber.matches('^ENQ-[0-9]{4}-[0-9]{4}$')
               && isPresentString(data.customerId)
               && data.customerMobile is string
               && data.source in ['walk-in', 'phone', 'whatsapp', 'referral', 'repeat', 'other']
               && data.status in ['new', 'contacted', 'follow-up', 'quotation-required',
                                  'converted', 'lost', 'closed']
               && data.requirementText is string && data.requirementText.size() <= 2000
               && data.followUps is list && data.followUps.size() <= 50
               && data.updatedBy is string;
      }

      allow get, list: if can('enquiries:view');

      allow create: if can('enquiries:create')
                    && isValidEnquiry(request.resource.data)
                    && request.resource.data.createdBy == request.auth.uid
                    && request.resource.data.updatedBy == request.auth.uid
                    && request.resource.data.status != 'converted'
                    && request.resource.data.convertedJobId == null;

      allow update: if can('enquiries:edit')
                    && resource != null
                    && isValidEnquiry(request.resource.data)
                    && request.resource.data.enquiryNumber == resource.data.enquiryNumber
                    && request.resource.data.createdAt == resource.data.createdAt
                    && request.resource.data.createdBy == resource.data.createdBy
                    && request.resource.data.updatedBy == request.auth.uid
                    && (
                         (request.resource.data.convertedJobId == resource.data.convertedJobId
                          && request.resource.data.status != 'converted'
                          && resource.data.convertedJobId == null)
                         || (resource.data.convertedJobId == null
                             && request.resource.data.convertedJobId is string
                             && request.resource.data.status == 'converted'
                             && can('jobs:create'))
                         || (resource.data.convertedJobId != null
                             && request.resource.data.convertedJobId == resource.data.convertedJobId
                             && request.resource.data.status == 'converted')
                       );

      allow delete: if false;
    }

    // Jobs. Never deleted; cancelled instead, so numbers stay meaningful.
    match /jobs/{jobId} {
      function isValidJob(data) {
        return data.keys().hasAll(['jobNumber', 'customerId', 'customerName', 'customerMobile',
                                   'jobDate', 'title', 'requirementText', 'priority', 'status',
                                   'createdAt', 'createdBy', 'updatedAt', 'updatedBy'])
               && data.keys().hasOnly(['jobNumber', 'customerId', 'customerName', 'customerMobile',
                                       'enquiryId', 'enquiryNumber', 'jobDate', 'title',
                                       'requirementText', 'requirementAudio', 'priority',
                                       'expectedDeliveryDate', 'internalNotes',
                                       'pickupLocationId', 'pickupLocationName',
                                       'contactPersonId', 'contactPersonName',
                                       'contactPersonMobile', 'assignedToId', 'assignedToName',
                                       'status', 'createdAt', 'createdBy',
                                       'updatedAt', 'updatedBy'])
               && data.jobNumber.matches('^JOB-[0-9]{4}-[0-9]{4}$')
               && isPresentString(data.customerId)
               && isPresentString(data.title) && data.title.size() <= 160
               && data.requirementText is string && data.requirementText.size() <= 2000
               && data.priority in ['normal', 'urgent']
               && data.status in ['open', 'in-progress', 'ready', 'delivered', 'on-hold',
                                  'cancelled']
               && nullableString(data.enquiryId)
               && nullableString(data.pickupLocationId)
               && nullableString(data.assignedToId)
               && data.updatedBy is string;
      }

      // Staff by permission; a customer only for their own orders, which is
      // what the review screen needs to show the requirement they gave us.
      // Money is not on this document - pricing lives in jobPricing - so
      // nothing here is hidden from the customer whose order it is.
      allow get, list: if can('jobs:view')
                       || isMyCustomerRecord(resource.data.customerId);

      allow create: if can('jobs:create')
                    && isValidJob(request.resource.data)
                    && request.resource.data.createdBy == request.auth.uid
                    && request.resource.data.updatedBy == request.auth.uid
                    && request.resource.data.assignedToId == null;

      allow update: if can('jobs:edit')
                    && resource != null
                    && isValidJob(request.resource.data)
                    && request.resource.data.jobNumber == resource.data.jobNumber
                    && request.resource.data.createdAt == resource.data.createdAt
                    && request.resource.data.createdBy == resource.data.createdBy
                    && request.resource.data.enquiryId == resource.data.enquiryId
                    && request.resource.data.updatedBy == request.auth.uid
                    // Changing who is responsible is a separate permission.
                    && (request.resource.data.assignedToId == resource.data.assignedToId
                        || can('jobs:assign'));

      allow delete: if false;
    }

    // The rate card. Anyone active may read it, because anyone pricing a job
    // needs it; only the owner may change it, and nothing is ever deleted.
    match /products/{productId} {
      function isValidProduct(data) {
        return data.keys().hasAll(['name', 'category', 'pricingMethod', 'defaultRate',
                                   'defaultRateUnit', 'isActive',
                                   'createdAt', 'createdBy', 'updatedAt', 'updatedBy'])
               && data.keys().hasOnly(['name', 'category', 'pricingMethod', 'defaultRate',
                                       'defaultRateUnit', 'description', 'isActive',
                                       'createdAt', 'createdBy', 'updatedAt', 'updatedBy'])
               && data.name is string && data.name.size() >= 2 && data.name.size() <= 120
               && data.category in ['printing', 'material', 'finishing', 'service', 'other']
               && data.pricingMethod in ['per-square-foot', 'per-square-meter',
                                         'per-running-foot', 'per-running-meter',
                                         'per-piece', 'flat-rate']
               && data.defaultRateUnit in ['sq-ft', 'sq-m', 'running-ft', 'running-m',
                                           'piece', 'flat']
               && isValidMoney(data.defaultRate)
               && data.defaultRate.paise >= 0
               && data.isActive is bool
               && data.updatedBy is string;
      }

      allow get, list: if isActiveUser();
      allow create: if can('settings:manage')
                    && isValidProduct(request.resource.data)
                    && request.resource.data.createdBy == request.auth.uid
                    && request.resource.data.updatedBy == request.auth.uid;
      allow update: if can('settings:manage')
                    && resource != null
                    && isValidProduct(request.resource.data)
                    && request.resource.data.createdAt == resource.data.createdAt
                    && request.resource.data.createdBy == resource.data.createdBy
                    && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if false;
    }

    // Job pricing. Kept out of the job document so that seeing a job never
    // means seeing what it costs: reading needs estimates:view, which designer
    // and production do not have. Writing needs both jobs:edit and
    // estimates:create, so production - which may move a job along - still
    // cannot change a price.
    match /jobPricing/{jobId} {
      function mayPrice() {
        return can('jobs:edit') && can('estimates:create');
      }

      allow get, list: if can('estimates:view');

      allow create: if mayPrice()
                    && isValidPricing(request.resource.data)
                    && request.resource.data.jobId == jobId
                    && request.resource.data.createdBy == request.auth.uid
                    && request.resource.data.updatedBy == request.auth.uid;

      allow update: if mayPrice()
                    && resource != null
                    && isValidPricing(request.resource.data)
                    && request.resource.data.jobId == resource.data.jobId
                    && request.resource.data.createdAt == resource.data.createdAt
                    && request.resource.data.createdBy == resource.data.createdBy
                    && request.resource.data.updatedBy == request.auth.uid;

      // Pricing history stays with the job it belongs to.
      allow delete: if false;
    }

    // Quotations are historical records. The priced lines, the totals and the
    // customer details are a snapshot taken at creation, so every update rule
    // below names exactly which keys a write may touch - nothing else can move,
    // whatever the client sends.
    match /estimates/{estimateId} {
      function isValidEstimate(data) {
        return data.keys().hasAll(['estimateNumber', 'jobId', 'jobNumber', 'jobTitle',
                                   'customerId', 'customerName', 'customerMobile',
                                   'estimateDate', 'validUntil', 'lines', 'subtotal', 'total',
                                   'status', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy'])
               && data.keys().hasOnly(['estimateNumber', 'jobId', 'jobNumber', 'jobTitle',
                                       'customerId', 'customerName', 'customerMobile',
                                       'customerBusinessName', 'customerAddress', 'customerGstin',
                                       'estimateDate', 'validUntil', 'lines', 'subtotal',
                                       'adjustment', 'total', 'notes', 'terms', 'status',
                                       'sentAt', 'decision', 'cancelledAt',
                                       'createdAt', 'createdBy', 'updatedAt', 'updatedBy'])
               && data.estimateNumber is string
               && data.jobId is string
               && data.customerId is string
               && data.lines is list
               && data.lines.size() > 0
               && data.lines.size() <= 50
               && isValidMoney(data.subtotal)
               && isValidMoney(data.total)
               && data.total.paise >= 0
               && data.status in ['draft', 'sent', 'approved', 'rejected', 'expired', 'cancelled']
               && data.updatedBy is string
               && (data.get('adjustment', null) == null
                   || (data.adjustment.keys().hasOnly(['amount', 'reason'])
                       && isValidMoney(data.adjustment.amount)
                       && data.adjustment.reason is string
                       && data.adjustment.reason.size() > 0));
      }

      function touchesOnly(fields) {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
      }

      function movesFromTo(from, allowed) {
        return resource.data.status == from
               && request.resource.data.status in allowed;
      }

      // Wording and validity, on a draft only. The snapshot is untouched.
      function isDraftEdit() {
        return can('estimates:edit')
               && resource.data.status == 'draft'
               && request.resource.data.status == 'draft'
               && touchesOnly(['validUntil', 'notes', 'terms', 'updatedAt', 'updatedBy']);
      }

      // The quotation went out to the customer.
      function isSendMove() {
        return can('estimates:edit')
               && movesFromTo('draft', ['sent'])
               && touchesOnly(['status', 'sentAt', 'updatedAt', 'updatedBy']);
      }

      // What the customer said, recorded against the staff member entering it.
      function isDecisionMove() {
        return can('estimates:approve')
               && movesFromTo('sent', ['approved', 'rejected'])
               && touchesOnly(['status', 'decision', 'updatedAt', 'updatedBy'])
               && request.resource.data.decision.keys().hasAll(['outcome', 'at', 'byId', 'byName'])
               && request.resource.data.decision.keys().hasOnly(['outcome', 'at', 'byId', 'byName', 'note'])
               && request.resource.data.decision.outcome == request.resource.data.status
               && request.resource.data.decision.byId == request.auth.uid;
      }

      // Withdrawn or past its validity date. Nothing is ever deleted.
      function isCloseMove() {
        return can('estimates:edit')
               && (movesFromTo('draft', ['cancelled'])
                   || movesFromTo('sent', ['expired', 'cancelled']))
               && touchesOnly(['status', 'cancelledAt', 'updatedAt', 'updatedBy']);
      }

      allow get, list: if can('estimates:view');

      allow create: if can('estimates:create')
                    && isValidEstimate(request.resource.data)
                    && request.resource.data.status == 'draft'
                    && request.resource.data.get('decision', null) == null
                    && request.resource.data.get('sentAt', null) == null
                    && request.resource.data.get('cancelledAt', null) == null
                    && request.resource.data.createdBy == request.auth.uid
                    && request.resource.data.updatedBy == request.auth.uid;

      allow update: if resource != null
                    && isValidEstimate(request.resource.data)
                    && request.resource.data.updatedBy == request.auth.uid
                    && (isDraftEdit() || isSendMove() || isDecisionMove() || isCloseMove());

      // A quotation that was given to a customer stays on record.
      allow delete: if false;
    }

    // A customer's login for the review portal.
    //
    // Separate from `users` on purpose: a customer is a different kind of
    // principal, not an employee with fewer permissions. The document id is the
    // Firebase Auth uid, exactly as it is for staff, and one uid can never hold
    // both kinds - each create refuses if the other already exists.
    match /customerAccounts/{uid} {
      function isValidAccount(data) {
        return data.keys().hasAll(['customerId', 'customerName', 'email',
                                   'preferredLanguage', 'isActive',
                                   'createdAt', 'createdBy', 'updatedAt', 'updatedBy'])
               && data.keys().hasOnly(['customerId', 'customerName', 'email',
                                       'preferredLanguage', 'isActive',
                                       'createdAt', 'createdBy', 'updatedAt', 'updatedBy'])
               && isPresentString(data.customerId)
               && data.customerName is string
               && data.email is string && data.email.size() >= 5 && data.email.size() <= 200
               && data.preferredLanguage in ['hi', 'en']
               && data.isActive is bool
               && data.updatedBy is string;
      }

      // A customer may read their own account and nothing else - not even the
      // existence of another. Staff read it through the customer permissions.
      allow get: if (isSignedIn() && request.auth.uid == uid) || can('customers:view');
      allow list: if can('customers:view');

      allow create: if can('customers:edit')
                    && isValidAccount(request.resource.data)
                    && request.resource.data.isActive == true
                    && request.resource.data.createdBy == request.auth.uid
                    && request.resource.data.updatedBy == request.auth.uid
                    // This uid must not already be an employee.
                    && !exists(userPath(uid));

      // Staff may switch portal access off and on. The link to the customer
      // record is fixed at creation: repointing a live login at a different
      // customer would hand somebody another customer's designs.
      allow update: if can('customers:edit')
                    && resource != null
                    && isValidAccount(request.resource.data)
                    && request.resource.data.customerId == resource.data.customerId
                    && request.resource.data.email == resource.data.email
                    && request.resource.data.createdAt == resource.data.createdAt
                    && request.resource.data.createdBy == resource.data.createdBy
                    && request.resource.data.updatedBy == request.auth.uid;

      // Access is revoked by deactivating, so the review history keeps a name.
      allow delete: if false;
    }

    // Design versions.
    //
    // Every version is its own immutable record: the file, the version number
    // and whatever the customer said about it are written once and never
    // rewritten. A revision is a new document, so approving artwork is a
    // statement about a specific file that stays true.
    //
    // Both principals write here. Staff upload and may record a decision on the
    // customer's behalf; a customer answers their own designs and nothing else.
    // Which of the two answered is pinned by these rules, so an answer cannot
    // be posted as though it came from the other side.
    match /designs/{designId} {
      function isValidDesign(data) {
        return data.keys().hasAll(['jobId', 'jobNumber', 'jobTitle', 'customerId',
                                   'customerName', 'version', 'file', 'preview',
                                   'uploadedById', 'uploadedByName', 'uploadedAt',
                                   'status', 'createdAt', 'createdBy',
                                   'updatedAt', 'updatedBy'])
               && data.keys().hasOnly(['jobId', 'jobNumber', 'jobTitle', 'customerId',
                                       'customerName', 'version', 'file', 'preview',
                                       'uploadedById', 'uploadedByName', 'uploadedAt',
                                       'status', 'designerNote', 'decision',
                                       'submittedAt', 'supersededAt',
                                       'createdAt', 'createdBy', 'updatedAt', 'updatedBy'])
               && isPresentString(data.jobId)
               && isPresentString(data.customerId)
               && data.version is int && data.version >= 1 && data.version <= 50
               && data.status in ['draft', 'submitted-for-review', 'changes-requested',
                                  'approved', 'rejected', 'superseded']
               && data.file.keys().hasOnly(['id', 'storagePath', 'mimeType', 'sizeBytes',
                                            'originalFileName', 'uploadedAt', 'uploadedById'])
               && isPresentString(data.file.storagePath)
               && data.file.mimeType in ['image/jpeg', 'image/png', 'image/webp',
                                         'application/pdf']
               && data.file.sizeBytes is int
               && data.file.sizeBytes > 0
               && data.file.sizeBytes <= 25 * 1024 * 1024
               && data.preview.keys().hasOnly(['kind', 'width', 'height'])
               && data.preview.kind in ['image', 'pdf']
               && data.updatedBy is string;
      }

      function touchesOnly(fields) {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
      }

      function movesFromTo(from, allowed) {
        return resource.data.status == from && request.resource.data.status in allowed;
      }

      // A decision names the outcome, keeps the comment - approval included -
      // and is attributed to whoever is actually signed in.
      function isWellFormedDecision(source) {
        return request.resource.data.decision.keys().hasAll(['outcome', 'comment', 'decidedAt',
                                                             'source', 'byId', 'byName'])
               && request.resource.data.decision.keys().hasOnly(['outcome', 'comment', 'decidedAt',
                                                                 'source', 'byId', 'byName',
                                                                 'language'])
               && request.resource.data.decision.outcome == request.resource.data.status
               && request.resource.data.decision.comment is string
               && request.resource.data.decision.comment.size() <= 2000
               && request.resource.data.decision.source == source
               && request.resource.data.decision.byId == request.auth.uid;
      }

      function isDecisionMove() {
        return movesFromTo('submitted-for-review', ['approved', 'rejected', 'changes-requested'])
               && touchesOnly(['status', 'decision', 'updatedAt', 'updatedBy']);
      }

      // The design is mine, and I am the customer it was sent to.
      function isMyDesign() {
        return isMyCustomerRecord(resource.data.customerId);
      }

      allow get, list: if can('designs:view') || isMyDesign();

      // Uploading writes the artwork and the version. It always starts on our
      // side of the conversation: a version can never be created already
      // answered, or answered by the person who uploaded it.
      allow create: if can('designs:upload')
                    && isValidDesign(request.resource.data)
                    && request.resource.data.status in ['draft', 'submitted-for-review']
                    && request.resource.data.get('decision', null) == null
                    && request.resource.data.get('supersededAt', null) == null
                    && request.resource.data.uploadedById == request.auth.uid
                    && request.resource.data.createdBy == request.auth.uid
                    && request.resource.data.updatedBy == request.auth.uid;

      allow update: if resource != null
                    && isValidDesign(request.resource.data)
                    && request.resource.data.updatedBy == request.auth.uid
                    // Nothing about the artwork itself can ever move: not the
                    // file, not the version, not who uploaded it, not the job
                    // or the customer it belongs to.
                    && request.resource.data.file == resource.data.file
                    && request.resource.data.preview == resource.data.preview
                    && request.resource.data.version == resource.data.version
                    && request.resource.data.jobId == resource.data.jobId
                    && request.resource.data.customerId == resource.data.customerId
                    && request.resource.data.uploadedById == resource.data.uploadedById
                    && request.resource.data.createdAt == resource.data.createdAt
                    && request.resource.data.createdBy == resource.data.createdBy
                    && (
                         // Staff send a draft to the customer.
                         (can('designs:upload')
                          && movesFromTo('draft', ['submitted-for-review'])
                          && touchesOnly(['status', 'submittedAt', 'updatedAt', 'updatedBy']))
                         ||
                         // Staff write down an answer the customer gave them by
                         // phone or in person. Recorded as staff, never as the
                         // customer.
                         (can('designs:approve')
                          && isDecisionMove()
                          && isWellFormedDecision('staff'))
                         ||
                         // The customer answers for themselves.
                         (isMyDesign()
                          && isDecisionMove()
                          && isWellFormedDecision('customer'))
                         ||
                         // A newer version takes over. Staff do this as part of
                         // uploading a revision; a customer does it only when
                         // their own approval replaces an earlier approval of
                         // theirs. Either way it changes the status alone - the
                         // decision and its comment stay exactly as written.
                         ((can('designs:upload') || isMyDesign())
                          && request.resource.data.status == 'superseded'
                          && resource.data.status != 'superseded'
                          && request.resource.data.get('decision', null)
                             == resource.data.get('decision', null)
                          && touchesOnly(['status', 'supersededAt', 'updatedAt', 'updatedBy']))
                       );

      // Design history is never destroyed, by either side.
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
